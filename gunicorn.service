[Unit]
Description=gunicorn instance to serve api
After=network.target

[Service]
User=fastapi
Group=fastapi
WorkingDirectory=/home/fastapi/app
Environment="PATH=/home/fastapi/app/.venv/bin"
ExecStart=/home/fastapi/app/.venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker main:app --bind 0.0.0.0:8000

[Install]
WantedBy=multi-user.target
